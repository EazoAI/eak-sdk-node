{
  "name": "@eazo/eak",
  "version": "0.1.1",
  "description": "Unified Node.js SDK for EAK Agent delegation, GUMem memory, and WebAgent automation.",
  "homepage": "https://github.com/EazoAI/eak-sdk-node#readme",
  "bugs": {
    "url": "https://github.com/EazoAI/eak-sdk-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EazoAI/eak-sdk-node.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "keywords": [
    "eak",
    "eazo",
    "agent",
    "sdk",
    "delegation",
    "gumem",
    "webagent"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "examples",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --coverage=false",
    "typecheck:examples": "pnpm build && tsc --noEmit -p tsconfig.examples.json",
    "pack:dry-run": "pnpm build && pnpm pack --dry-run",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "author": ""
}
