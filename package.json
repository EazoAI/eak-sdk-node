{
  "name": "@eazo/eak",
  "version": "0.1.1",
  "description": "Unified Node.js SDK for EAK Agent delegation, GUMem memory, and WebAgent automation.",
  "homepage": "https://github.com/EazoAI/eak-sdk-node#readme",
  "bugs": {
    "url": "https://github.com/EazoAI/eak-sdk-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EazoAI/eak-sdk-node.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "keywords": [
    "eak",
    "eazo",
    "agent",
    "sdk",
    "delegation",
    "gumem",
    "webagent"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "examples",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run --coverage=false",
    "typecheck:examples": "pnpm build && tsc --noEmit -p tsconfig.examples.json",
    "pack:dry-run": "pnpm build && pnpm pack --dry-run",
    "prepack": "pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "any-promise": "^1.3.0",
    "assertion-error": "^2.0.1",
    "bundle-require": "^5.1.0",
    "cac": "^6.7.14",
    "chai": "^5.3.3",
    "check-error": "^2.1.3",
    "chokidar": "^4.0.3",
    "commander": "^4.1.1",
    "confbox": "^0.1.8",
    "consola": "^3.4.2",
    "debug": "^4.4.3",
    "deep-eql": "^5.0.2",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.27.7",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.3.0",
    "fdir": "^6.5.0",
    "fix-dts-default-cjs-exports": "^1.0.1",
    "joycon": "^3.1.1",
    "lilconfig": "^3.1.3",
    "lines-and-columns": "^1.2.4",
    "load-tsconfig": "^0.2.5",
    "loupe": "^3.2.1",
    "magic-string": "^0.30.21",
    "mlly": "^1.8.2",
    "ms": "^2.1.3",
    "mz": "^2.7.0",
    "nanoid": "^3.3.12",
    "object-assign": "^4.1.1",
    "pathe": "^2.0.3",
    "pathval": "^2.0.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4",
    "pirates": "^4.0.7",
    "pkg-types": "^1.3.1",
    "postcss": "^8.5.14",
    "postcss-load-config": "^6.0.1",
    "readdirp": "^4.1.2",
    "resolve-from": "^5.0.0",
    "rollup": "^4.60.4",
    "siginfo": "^2.0.0",
    "source-map": "^0.7.6",
    "source-map-js": "^1.2.1",
    "stackback": "^0.0.2",
    "std-env": "^3.10.0",
    "sucrase": "^3.35.1",
    "thenify": "^3.3.1",
    "thenify-all": "^1.6.0",
    "tinybench": "^2.9.0",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.16",
    "tinypool": "^1.1.1",
    "tinyrainbow": "^1.2.0",
    "tinyspy": "^3.0.2",
    "tree-kill": "^1.2.2",
    "ts-interface-checker": "^0.1.13",
    "ufo": "^1.6.4",
    "undici-types": "^6.21.0",
    "vite": "^5.4.21",
    "vite-node": "^2.1.9",
    "why-is-node-running": "^2.3.0"
  },
  "author": ""
}
