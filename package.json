{
  "name": "@eazo/eak",
  "version": "0.1.0",
  "description": "Unified Node.js SDK for EAK Agent delegation, GUMem memory, and WebAgent automation.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "keywords": [
    "eak",
    "eazo",
    "agent",
    "sdk",
    "delegation",
    "gumem",
    "webagent"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
